{
  "publisher": "palmcivet",
  "name": "kiwi-vscode",
  "displayName": "Kiwi VSCode",
  "version": "1.3.0",
  "private": true,
  "description": "Better support for the Kiwi message format in VSCode.",
  "author": "Palm Civet",
  "contributors": [
    {
      "name": "Connor Skees",
      "url": "https://github.com/connorskees"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/palmcivet/kiwi-vscode"
  },
  "main": "./client/out/extension",
  "icon": "./assets/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "package": "vsce package --no-dependencies",
    "clean": "pnpm -r --parallel --filter='*' clean",
    "clean:deps": "pnpm dlx rimraf -g node_modules **/*/node_modules",
    "build": "pnpm -r --stream --filter='*' build",
    "test": "pnpm -r --stream --filter='*' test",
    "format": "prettier --write .",
    "release": "release-it"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@vscode/vsce": "^3.9.2",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release v${version}",
      "tagName": "v${version}"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "pnpm test",
        "pnpm build"
      ],
      "after:bump": "pnpm package"
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular",
        "infile": "CHANGELOG.md"
      }
    }
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript@<=7.0.2": "^7.0.3",
      "undici@<6.28.0": "^6.28.0",
      "undici@>=7.0.0 <7.29.0": "^7.29.0",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "defu@<=6.1.4": "^6.1.6",
      "lodash@<=4.17.23": "^4.18.1",
      "basic-ftp@<=5.3.0": "^5.3.1",
      "tmp@<0.2.6": "^0.2.6",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "linkify-it@<=5.0.1": "^5.0.2",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "postcss@<=8.5.22": "^8.5.23",
      "ip-address@<=10.3.0": "^10.3.1",
      "nanoid@<3.3.18": "^3.3.18",
      "uuid@<11.1.1": "^11.1.1",
      "qs@>=6.11.1 <=6.15.1": "^6.15.2",
      "markdown-it@<=14.1.1": "^14.2.0",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "diff@>=6.0.0 <8.0.3": "^8.0.3"
    }
  },
  "contributes": {
    "configuration": {
      "title": "Kiwi",
      "properties": {
        "kiwi-vscode.enableWarningDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable warning diagnostics."
        },
        "kiwi-vscode.enableFormatting": {
          "type": "boolean",
          "default": true,
          "description": "(Beta) Enable code formatting."
        },
        "kiwi-vscode.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic update checking from GitHub Releases."
        }
      }
    },
    "commands": [
      {
        "command": "kiwi-vscode.checkForUpdates",
        "title": "Check for Updates",
        "category": "Kiwi"
      }
    ],
    "languages": [
      {
        "id": "kiwi",
        "aliases": [
          "Kiwi",
          "kiwi"
        ],
        "extensions": [
          ".kiwi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kiwi",
        "scopeName": "source.kiwi",
        "path": "./syntaxes/kiwi.tmLanguage.json"
      }
    ]
  }
}
